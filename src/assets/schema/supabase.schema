-- Create a table for public user profiles
create table profiles (
  id uuid references auth.users not null primary key,
  created_at timestamp with time zone default now(),
  updated_at timestamp with time zone,
  username text unique,
  full_name text,
  birthdate date,
  contact_number text,
  address text,
  barangay text,
  city text,
  province text,

  constraint username_length check (char_length(username) >= 3)
);

-- Set up Row Level Security (RLS)
alter table profiles
  enable row level security;

create policy "Public profiles are viewable by everyone." on profiles
  for select using (true);

create policy "Users can insert their own profile." on profiles
  for insert with check (auth.uid() = id);

create policy "Users can update own profile." on profiles
  for update using (auth.uid() = id);

-- Function to update the updated_at column
create or replace function public.handle_profile_update()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql security definer;

-- Trigger to automatically update the updated_at timestamp on profile updates
create trigger on_profile_updated
  before update on public.profiles
  for each row execute procedure public.handle_profile_update();

-- Function to create a profile for a new user
create function public.handle_new_user()
returns trigger as $$
begin
  insert into public.profiles (id, username, full_name, birthdate)
  values (
    new.id,
    new.raw_user_meta_data->>'username',
    new.raw_user_meta_data->>'full_name',
    (new.raw_user_meta_data->>'birthdate')::date
  );
  return new;
end;
$$ language plpgsql security definer;

-- Trigger to execute the function after a new user is created in auth.users
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute procedure public.handle_new_user();

-- Add role column to profiles table
alter table public.profiles
add column role text not null default 'customer'
check (
    role in (
        'customer',
        'rider',
        'admin'
    )
);

-- ==========================================
-- RIDERS TABLE (FETCH APP)
-- ==========================================

create table public.riders (
    id uuid primary key
        references public.profiles(id)
        on delete cascade,

    created_at timestamptz not null default now(),
    updated_at timestamptz not null default now(),

    -- Driver Information
    drivers_license_number text not null unique,
    drivers_license_expiry date not null,
    drivers_license_image text not null,

    -- Vehicle Information
    vehicle_type text not null
        check (
            vehicle_type in (
                'Motorcycle - Automatic',
                'Motorcycle - Manual',
                'Car - 2 Seater',
                'Car - 4 Seater',
                'Car - 6 Seater',
                'Car - 8 Seater',
                'Tricycle',
                'Bicycle'
            )
        ),

    vehicle_image text not null,
    vehicle_brand text not null,
    vehicle_model text not null,
    vehicle_color text not null,

    vehicle_plate_number text unique,
    vehicle_registration_expiry date,

    -- Emergency Contact
    emergency_contact_name text not null,
    emergency_contact_number text not null,

    -- GCash (Payout)
    gcash_name text,
    gcash_number text
        check (
            gcash_number is null
            or gcash_number ~ '^09[0-9]{9}$'
        ),

    -- Rider Status
    rider_status text not null default 'Pending'
        check (
            rider_status in (
                'Pending',
                'Approved',
                'Rejected',
                'Suspended'
            )
        ),

    verified_at timestamptz,
    suspension_reason text,

    -- Availability
    is_online boolean not null default false,

    -- Live Location
    current_latitude numeric(10,8),
    current_longitude numeric(11,8),

    -- Stats
    rating numeric(3,2) not null default 5.00
        check (
            rating >= 0
            and rating <= 5
        ),

    total_ratings integer not null default 0,
    total_deliveries integer not null default 0,

    last_online_at timestamptz
);

-- ==========================================
-- RLS ENABLE
-- ==========================================

alter table public.riders
enable row level security;

-- ==========================================
-- POLICIES
-- ==========================================

-- Rider can view own profile
create policy "Rider can view own profile"
on public.riders
for select
using (
    auth.uid() = id
);

-- Rider can create own profile
create policy "Rider can create own profile"
on public.riders
for insert
with check (
    auth.uid() = id
);

-- Rider can update own profile
create policy "Rider can update own profile"
on public.riders
for update
using (
    auth.uid() = id
);

-- Admin can view all riders
create policy "Admins can view riders"
on public.riders
for select
using (
    exists (
        select 1
        from public.profiles p
        where p.id = auth.uid()
        and p.role = 'admin'
    )
);

-- Admin can manage riders
create policy "Admins manage riders"
on public.riders
for all
using (
    exists (
        select 1
        from public.profiles p
        where p.id = auth.uid()
        and p.role = 'admin'
    )
);

-- ==========================================
-- AUTO UPDATE TIMESTAMP
-- ==========================================

create or replace function public.handle_rider_update()
returns trigger as $$
begin
    new.updated_at = now();
    return new;
end;
$$ language plpgsql;

create trigger on_rider_updated
before update on public.riders
for each row
execute procedure public.handle_rider_update();

create table public.bookings (
    id uuid primary key default gen_random_uuid(),

    created_at timestamptz not null default now(),
    updated_at timestamptz not null default now(),

    -- Who created the booking
    customer_id uuid not null
        references public.profiles(id)
        on delete cascade,

    -- Assigned rider (null until accepted)
    rider_id uuid
        references public.riders(id)
        on delete set null,

    -- Service type
    booking_type text not null
        check (
            booking_type in (
                'Padala',
                'PasaBuy',
                'Pahatod'
            )
        ),

    -- Booking status flow
    status text not null default 'Waiting for Rider'
        check (
            status in (
                'Waiting for Rider',
                'Accepted',
                'On-going',
                'Completed',
                'Cancelled'
            )
        ),

    -- =========================
    -- PICKUP DETAILS
    -- =========================
    pickup_address text not null,
    pickup_barangay text,
    pickup_city text,
    pickup_province text,
    pickup_latitude numeric(10,8),
    pickup_longitude numeric(11,8),
    pickup_contact_name text,
    pickup_contact_number text,

    -- =========================
    -- DROPOFF DETAILS
    -- =========================
    dropoff_address text not null,
    dropoff_barangay text,
    dropoff_city text,
    dropoff_province text,
    dropoff_latitude numeric(10,8),
    dropoff_longitude numeric(11,8),
    dropoff_contact_name text,
    dropoff_contact_number text,

    -- =========================
    -- SCHEDULING / TIMELINE
    -- =========================
    scheduled_at timestamptz,
    accepted_at timestamptz,
    picked_up_at timestamptz,
    completed_at timestamptz,
    cancelled_at timestamptz,

    -- =========================
    -- ITEM DETAILS
    -- =========================
    item_description text,
    item_weight_kg numeric(6,2),
    item_value numeric(10,2),

    -- =========================
    -- CUSTOMER → RIDER NOTES
    -- =========================
    customer_to_rider_notes text,

    -- =========================
    -- PRICING
    -- =========================
    base_fare numeric(10,2),
    distance_km numeric(10,2),
    total_fare numeric(10,2),

    -- =========================
    -- PAYMENT
    -- =========================
    payment_method text
        check (
            payment_method in (
                'Cash',
                'GCash'
            )
        ),

    payment_status text default 'Pending'
        check (
            payment_status in (
                'Pending',
                'Paid',
                'Failed',
                'Refunded'
            )
        )
);

-- ==========================================
-- 1. LIVE CURRENT LOCATION (FAST READ)
-- ==========================================

create table public.booking_current_location (
    booking_id uuid primary key
        references public.bookings(id)
        on delete cascade,

    rider_id uuid not null
        references public.riders(id)
        on delete cascade,

    latitude numeric(10,8) not null,
    longitude numeric(11,8) not null,

    speed_kph numeric(5,2),
    heading numeric(5,2),
    accuracy_meters numeric(5,2),

    updated_at timestamptz not null default now()
);

-- ==========================================
-- 2. TRACKING HISTORY (FULL GPS LOG)
-- ==========================================

create table public.booking_tracking_history (
    id uuid primary key default gen_random_uuid(),

    booking_id uuid not null
        references public.bookings(id)
        on delete cascade,

    rider_id uuid not null
        references public.riders(id)
        on delete cascade,

    latitude numeric(10,8) not null,
    longitude numeric(11,8) not null,

    speed_kph numeric(5,2),
    heading numeric(5,2),
    accuracy_meters numeric(5,2),

    recorded_at timestamptz not null default now()
);

-- ==========================================
-- 3. INDEXES (PERFORMANCE BOOST)
-- ==========================================

create index idx_booking_tracking_history_booking_id
on public.booking_tracking_history(booking_id);

create index idx_booking_tracking_history_recorded_at
on public.booking_tracking_history(recorded_at);

create index idx_booking_current_location_booking_id
on public.booking_current_location(booking_id);

-- ==========================================
-- 4. OPTIONAL: AUTO UPDATE FUNCTION (for live table if needed)
-- ==========================================

create or replace function public.handle_current_location_update()
returns trigger as $$
begin
    new.updated_at = now();
    return new;
end;
$$ language plpgsql;

create trigger on_current_location_updated
before update on public.booking_current_location
for each row
execute procedure public.handle_current_location_update();

-- ==========================================
-- RATINGS TABLE (PRO LEVEL)
-- ==========================================

create table public.ratings (
    id uuid primary key default gen_random_uuid(),

    created_at timestamptz not null default now(),

    -- Context (VERY IMPORTANT: ties rating to a completed booking)
    booking_id uuid not null
        references public.bookings(id)
        on delete cascade,

    -- Who rated (customer)
    customer_id uuid not null
        references public.profiles(id)
        on delete cascade,

    -- Who is being rated (rider)
    rider_id uuid not null
        references public.riders(id)
        on delete cascade,

    -- Main rating
    rating integer not null
        check (rating >= 1 and rating <= 5),

    comment text,

    -- Optional breakdown (pro feature)
    punctuality_rating integer
        check (punctuality_rating >= 1 and punctuality_rating <= 5),

    behavior_rating integer
        check (behavior_rating >= 1 and behavior_rating <= 5),

    service_rating integer
        check (service_rating >= 1 and service_rating <= 5),

    -- Optional moderation (for future abuse control)
    is_flagged boolean default false,
    flag_reason text
);

-- ==========================================
-- PREVENT DUPLICATE RATINGS
-- (1 rating per customer per booking)
-- ==========================================

create unique index unique_rating_per_booking_customer
on public.ratings(customer_id, booking_id);

-- ==========================================
-- PERFORMANCE INDEXES
-- ==========================================

create index idx_ratings_rider_id
on public.ratings(rider_id);

create index idx_ratings_booking_id
on public.ratings(booking_id);

create index idx_ratings_customer_id
on public.ratings(customer_id);

-- ==========================================
-- 1. BASE FARE RULES (CORE ENGINE)
-- ==========================================

create table public.fare_rules (
    id uuid primary key default gen_random_uuid(),

    service_type text not null
        check (
            service_type in ('Padala', 'PasaBuy', 'Pahatod')
        ),

    base_fare numeric(10,2) not null default 0,

    price_per_km numeric(10,2) not null,

    minimum_fare numeric(10,2) not null default 0,

    is_active boolean not null default true,

    created_at timestamptz not null default now()
);

-- ==========================================
-- 2. SURGE PRICING (DYNAMIC MULTIPLIER)
-- ==========================================

create table public.surge_pricing (
    id uuid primary key default gen_random_uuid(),

    service_type text not null
        check (
            service_type in ('Padala', 'PasaBuy', 'Pahatod')
        ),

    multiplier numeric(4,2) not null default 1.00,

    reason text,

    start_time timestamptz,
    end_time timestamptz,

    is_active boolean not null default true,

    created_at timestamptz not null default now()
);

-- ==========================================
-- 3. DISTANCE TIER PRICING (OPTIONAL PRO LAYER)
-- ==========================================

create table public.fare_distance_tiers (
    id uuid primary key default gen_random_uuid(),

    service_type text not null,

    min_km numeric(10,2) not null default 0,
    max_km numeric(10,2),

    price_per_km numeric(10,2) not null,

    created_at timestamptz not null default now()
);

-- ==========================================
-- 4. PERFORMANCE INDEXES
-- ==========================================

create index idx_fare_rules_service_type
on public.fare_rules(service_type);

create index idx_surge_pricing_service_type
on public.surge_pricing(service_type);

create index idx_surge_pricing_active
on public.surge_pricing(is_active);

create index idx_distance_tiers_service_type
on public.fare_distance_tiers(service_type);